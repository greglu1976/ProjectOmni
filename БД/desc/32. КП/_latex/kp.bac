%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%  УПРАВЛЕНИЕ ВЫКЛЮЧАТЕЛЕМ %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\begin{flushleft}
\needspace{3\baselineskip}
\color{uniblue}{\subsubsection{Управление выключателем (УВ)}}
\color{black}
\nopagebreak
\end{flushleft}

\par
Ввод функции \textbf{<<УВ>>} в работу на этапе параметрирования устройства осуществляется программным переключателем \textbf{SGF1 <<Ввод\_функции>>}. Введенное состояние функции соответствует активному состоянию сигнала \textbf{<<УВ: Ввод>>}.
Функция \textbf{<<УВ>>} формирует команды на отключение и включение выключателя при оперативном управлении.

\par
Команда \emph{оперативного отключения} \textbf{<<УВ: Отключить>>} формируется в следующих случаях:
\begin{itemize}
	\item при появлении команды на оперативное отключение выключателя (\textbf{<<Отключить В~от~ПУ>> или <<Откл. В~ИЧМ>>}) и выбранным управлением по месту (сигнал \textbf{<<Местное>>} находится в активном состоянии);
	\item при появлении команды на оперативное отключение выключателя (\textbf{<<Отключить В~от~ТУ>> или <<Откл. В~АСУ>>}) и выбранным дистанционным управлением (сигнал \textbf{<<Дистанционное>>} находится в активном состоянии).
\end{itemize}
Прохождение команды на отключение блокируется при наличии следующих сигналов:
\begin{itemize}
	\item запрет отключения от функции контроля силового выключателя \textbf{<<КСВ: Блокировка откл>>};
	\item отключенное состояние силового выключателя \textbf{<<В: Отключен>>};
	\item превышение времени переключения силового выключателя \textbf{<<УВ: Прев. времени~пер.>>};
	\item местное управление силовым выключателем (положение переключателя \textbf{<<М/Д>>} в приводе выключателя) \textbf{<<В:~Ключ М/Д привода>>}.
\end{itemize}

\par
Команда \emph{оперативного включения} \textbf{<<УВ: Включить>>} формируется в следующих случаях:
\begin{itemize}
	\item при появлении команды на оперативное включение выключателя (\textbf{<<Включить В~от~ПУ>> или <<Вкл. В~ИЧМ>>}) и выбранным управлением по месту (сигнал \textbf{<<Местное>>} находится в активном состоянии);
	\item при появлении команды на оперативное включение выключателя (\textbf{<<Включить В~от~ТУ>> или <<Вкл. В~АСУ>>}) и выбранным дистанционным управлением (сигнал \textbf{<<Дистанционное>>} находится в активном состоянии).
\end{itemize}
Прохождение команды на включение блокируется при наличии следующих сигналов:
\begin{itemize}
	\item запрет включения от функции контроля силового выключателя \textbf{<<КСВ: Блокировка вкл>>};
	\item включенное состояние силового выключателя \textbf{<<В:~Включен>>};
	\item превышение времени переключения силового выключателя \textbf{<<УВ: Прев. времени~пер.>>};
	\item местное управление силовым выключателем (положение переключателя \textbf{<<М/Д>>} в приводе выключателя) \textbf{<<В:~Ключ М/Д привода>>};
	\item появление сигнала аварийного отключения силового выключателя \textbf{<<КСВ: В аварийно отключен>>} (прохождение сигнала определяется состоянием программного переключателя \textbf{SGF2 <<Бл\_вкл\_от\_авар\_откл>>}).
\end{itemize}

\par
При наличии сигналов \textbf{<<УВ: Включить>>} и \textbf{<<УВ: Отключить>>} длительностью больше, чем время уставки \textbf{<<T1>>} формируется сигнал превышения допустимого времени переключения -- \textbf{<<УВ: Прев. времени пер.>>}. Активное состояние операции включения или отключения сигнализируется выходным сигналом \textbf{<<УВ: Идет переключение>>}.

\par
Логика функции \textbf{<<УВ>>} формирует сигналы состояния выключателя \textbf{<<УВ: Отключено>>}, \textbf{<<УВ: Включено>>}, \textbf{<<УВ: Не определено>>} и \textbf{<<УВ: Неисправность>>}, при этом сигналы \textbf{<<УВ: Неисправность>>} и \textbf{<<УВ: Не определено>>} выдаются с выдержкой времени, задаваемой уставкой \textbf{Т2 <<Тблк>>}).

\par
Алгоритм работы \textbf{<<УВ>>} выполнен в соответствии с рисунком \ref{kp:img_uv}. В таблице \ref{kp:tbl_uv} приведены параметры, необходимые для настройки функции \textbf{<<УВ>>}.

